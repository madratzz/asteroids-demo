# Normalize line endings: store LF in the repo, check out LF everywhere.
# Without this, Windows tooling (Unity on Windows, editors with CRLF defaults)
# re-dirties the working tree on this NTFS drive with phantom modifications.
* text=auto eol=lf

# --- Unity / C# text assets ---------------------------------------------
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.mat text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

